{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "preLaunchTask": null,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flutter (Profile Mode)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--profile"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flutter (Release Mode)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--release"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
